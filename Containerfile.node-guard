# RamShield node-guard runtime. Unlike the ordinary distroless server image,
# this image intentionally carries the small host-network toolset required by
# XDP/RSS/SYNPROXY setup: nft, sysctl, and ethtool.
#
# The container still runs as UID 65532 and receives only the capabilities listed
# by deploy/k8s/daemonset.yaml. It is never used for the ordinary server pod.
FROM debian:bookworm-slim
ENV PATH=/usr/sbin:/usr/bin:/sbin:/bin
RUN apt-get update \
    && apt-get install -y --no-install-recommends nftables procps ethtool ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system --gid 65532 ramshield \
    && useradd --system --uid 65532 --gid 65532 --no-create-home --shell /usr/sbin/nologin ramshield \
    && mkdir -p /etc/ramshield /var/lib/ramshield /sys/fs/bpf \
    && chown -R 65532:65532 /etc/ramshield /var/lib/ramshield
COPY target/release/ramshield /usr/local/bin/ramshield
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/ramshield"]
