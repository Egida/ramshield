{# k8s-deployment.yaml.j2 — rendered image-tag Deployment for local k8s apply #}
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ramshield
  namespace: {{ k8s_namespace | default('ramshield') }}
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app.kubernetes.io/name: ramshield
  template:
    metadata:
      labels:
        app.kubernetes.io/name: ramshield
    spec:
      containers:
        - name: ramshield
          image: {{ k8s_image | default('ghcr.io/grep999/ramshield') }}:{{ k8s_image_tag | default('latest') }}
          args: ["--config", "/etc/ramshield/config.toml"]
