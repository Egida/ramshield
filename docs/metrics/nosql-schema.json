{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ramshield.local/schema/metric-observability.json",
  "title": "RamShield metric observability document model",
  "type": "object",
  "required": ["modules", "metrics", "relations", "evidence"],
  "properties": {
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "crate", "responsibilities"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "label": {"type": "string"},
          "crate": {"type": "string"},
          "responsibilities": {"type": "array", "items": {"type": "string"}},
          "runtime_targets": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "kind", "unit", "owner_module", "writers", "readers", "invariants"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"},
          "name": {"type": "string"},
          "kind": {"enum": ["counter", "gauge", "rate", "snapshot", "histogram", "derived"]},
          "unit": {"type": "string"},
          "owner_module": {"type": "string"},
          "writers": {"type": "array", "items": {"type": "string"}},
          "readers": {"type": "array", "items": {"type": "string"}},
          "invariants": {"type": "array", "items": {"type": "string"}},
          "zero_semantics": {"type": "string"},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "test_refs": {"type": "array", "items": {"type": "string"}},
          "log_events": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "type", "to"],
        "properties": {
          "from": {"type": "string"},
          "type": {"enum": ["writes", "reads", "exports", "renders", "verifies", "derived_from", "logs"]},
          "to": {"type": "string"},
          "evidence": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "command", "asserts"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"enum": ["unit", "smoke", "integration", "runtime", "source"]},
          "command": {"type": "string"},
          "asserts": {"type": "array", "items": {"type": "string"}},
          "artifact": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
