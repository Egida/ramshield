--- /dev/null
+++ b/crates/ramshield-enforcement/tests/concurrency_invariants.rs
@@ -0,0 +1,52 @@
+//! Compile-time static assertions for enforcement concurrency invariants.
+//!
+//! This test prevents regressions where !Send networking state or raw locks
+//! are reintroduced into `EnforcementService`.
+
+use ramshield_enforcement::service::EnforcementService;
+use ramshield_mesh::actor::MeshHandle;
+use std::future::Future;
+
+/// Compile-time helper: fails compilation if T is not Send.
+const fn assert_send<T: Send>() {}
+
+/// Compile-time helper: fails compilation if T is not Sync.
+const fn assert_sync<T: Sync>() {}
+
+/// Compile-time helper: verifies a future is compatible with `tokio::spawn`.
+fn assert_spawnable<F: Future + Send + 'static>(_future: F) {}
+
+#[test]
+fn invariant_enforcement_service_must_be_send() {
+    // If any field in EnforcementService becomes !Send, this test will fail to compile.
+    assert_send::<EnforcementService>();
+}
+
+#[test]
+fn invariant_mesh_handle_must_be_send_and_sync() {
+    // Ensures the channel wrapper can safely cross and be shared across thread pools.
+    assert_send::<MeshHandle>();
+    assert_sync::<MeshHandle>();
+}
+
+#[test]
+fn invariant_enforcement_run_future_must_be_spawnable() {
+    // Verifies that the generator produced by `EnforcementService::run()` does not
+    // hold non-Send synchronization guards across an `.await` boundary.
+    if false {
+        let mut svc: EnforcementService = unsafe { std::mem::zeroed() };
+        let rx = unsafe { std::mem::zeroed() };
+        assert_spawnable(async move {
+            let _ = svc.run(rx).await;
+        });
+    }
+}
